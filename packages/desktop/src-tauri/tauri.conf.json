{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abel",
  "version": "0.1.0",
  "identifier": "com.abel.app",
  "build": {
    "beforeDevCommand": "node ./scripts/prepare-abel-skills.mjs && node ./scripts/tauri-before-dev.mjs",
    "beforeBuildCommand": "node ./scripts/prepare-bundled-tools.mjs && node ./scripts/prepare-abel-skills.mjs && pnpm -C ../.. --filter @different-ai/abel run prepare:sidecar && pnpm -w build:abel",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../abel-app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Abel",
        "width": 1180,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "resources": {
      "bundled-tools": "bundled-tools/",
      "abel-skills.zip": "abel-skills.zip"
    },
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecars/opencode",
      "sidecars/openwork-server",
      "sidecars/opencode-router",
      "sidecars/openwork-orchestrator",
      "sidecars/chrome-devtools-mcp",
      "sidecars/versions.json"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "abel"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgNTVERTlENEU5MDM4OTQ0RQpSV1JPbERpUVRwM2VWUkVOZ0xsV1N4SzRmZEVzTlZvQ0pNOXdTMHlIUEd5UU1uWlArektIeTVzUwo=",
      "endpoints": [
        "https://github.com/Soilverts/openwork/releases/latest/download/latest.json"
      ]
    }
  }
}
